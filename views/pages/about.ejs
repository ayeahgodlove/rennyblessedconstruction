<%- include("../layout/header") %>
<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="background: linear-gradient(135deg, rgba(26, 37, 47, 0.8) 0%, rgba(44, 62, 80, 0.8) 100%), url(assets/img/page-title-bg.jpg) center/cover no-repeat"
  >
    <div class="container position-relative">
      <h1 class="heading-modern">About <span class="text-gradient">RB Construction</span></h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">About</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->

  <!-- About Section -->
  <section id="about" class="about section">
    <div class="container">
      <div class="row align-items-center">
        <div
          class="col-lg-5 about-img"
          data-aos="zoom-out"
          data-aos-delay="200"
        >
          <img src="assets/img/about.jpg" class="img-fluid rounded-3 shadow-modern" alt="RB Construction Team" />
        </div>

        <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
          <h2 class="inner-title heading-modern">Our <span class="text-gradient">Story</span></h2>
          <div class="our-story card-modern p-4">
            <p class="lead mb-4">
              Founded with a vision to revolutionize construction in Cameroon, RB Construction & Engineering 
              Associate has grown from a small consultancy into a leading multidisciplinary construction company. 
              We specialize in delivering complex construction projects that combine innovative engineering 
              solutions with sustainable building practices.
            </p>
            <p class="mb-4">
              Our team of certified engineers, skilled architects, and experienced project managers brings 
              decades of construction expertise to every project. We pride ourselves on delivering buildings 
              that not only meet but exceed industry standards for safety, durability, and environmental responsibility.
            </p>
            <div class="values-grid row g-3">
              <div class="col-md-6">
                <div class="value-item d-flex align-items-center">
                  <i class="bi bi-check-circle-fill text-warning me-3"></i>
                  <span class="fw-semibold">Quality Construction</span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="value-item d-flex align-items-center">
                  <i class="bi bi-check-circle-fill text-warning me-3"></i>
                  <span class="fw-semibold">Safety First</span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="value-item d-flex align-items-center">
                  <i class="bi bi-check-circle-fill text-warning me-3"></i>
                  <span class="fw-semibold">Timely Delivery</span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="value-item d-flex align-items-center">
                  <i class="bi bi-check-circle-fill text-warning me-3"></i>
                  <span class="fw-semibold">Innovative Engineering</span>
                </div>
              </div>
            </div>
            <div class="watch-video d-flex align-items-center mt-4">
              <i class="bi bi-play-circle-fill text-warning me-2 fs-3"></i>
              <a href="https://www.youtube.com/watch?v=Y7f98aduVJ8" class="glightbox text-decoration-none fw-semibold">
                Watch Our Story
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /About Section -->

  <!-- Stats Counter Section -->
  <section id="stats-counter" class="stats-counter section">
    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
      <h2 class="heading-modern">Our Construction <span class="text-gradient">Achievements</span></h2>
      <p class="lead">
        Our track record speaks for itself. With successful projects across Cameroon, 
        we've built a reputation for excellence in construction, engineering, and project management.
      </p>
    </div>
    <!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row justify-content-center gy-4">
        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-check-circle-fill color-blue flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="10"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Years of Experience</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-broadcast color-blue flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="10"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Geographical Reach</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-award-fill color-blue flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="10"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Awards & Recognition</p>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-emoji-smile color-blue flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="<%= testimonialCount %>"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Satisfied Clients</p>
            </div>
          </div>
        </div>
        <!-- End Stats Item -->

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-journal-richtext color-orange flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="<%= projectCount %>"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Projects</p>
            </div>
          </div>
        </div>
        <!-- End Stats Item -->

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-headset color-green flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="1463"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Hours Of Support</p>
            </div>
          </div>
        </div>
        <!-- End Stats Item -->

        <div class="col-lg-3 col-md-6">
          <div class="stats-item d-flex align-items-center w-100 h-100">
            <i class="bi bi-people color-pink flex-shrink-0"></i>
            <div>
              <span
                data-purecounter-start="0"
                data-purecounter-end="<%= teamCount %>"
                data-purecounter-duration="1"
                class="purecounter"
              ></span>
              <p>Team Size</p>
            </div>
          </div>
        </div>
        <!-- End Stats Item -->
      </div>
    </div>
  </section>
  <!-- /Stats Counter Section -->

  <!-- Service Start -->
  <%- include("../partials/home/service") %>
  <!-- Service End -->

