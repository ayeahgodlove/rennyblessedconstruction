<%- include("../layout/header") %>
<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="background: linear-gradient(135deg, rgba(26, 37, 47, 0.8) 0%, rgba(44, 62, 80, 0.8) 100%), url(assets/img/page-title-bg.jpg) center/cover no-repeat"
  >
    <div class="container position-relative">
      <h1 class="heading-modern">Get In <span class="text-gradient">Touch</span></h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Contact</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->

  <!-- Contact Section -->
  <section id="contact" class="contact section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row gy-4">
        <div class="col-lg-6">
          <div
            class="info-item card-modern p-4 text-center"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <i class="bi bi-geo-alt-fill text-warning fs-1 mb-3"></i>
            <h4 class="mb-3">Our Location</h4>
            <p class="mb-0">Nkwen Bamenda, Cameroon</p>
          </div>
        </div>
        <!-- End Info Item -->

        <div class="col-lg-3 col-md-6">
          <div
            class="info-item card-modern p-4 text-center"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <i class="bi bi-telephone-fill text-warning fs-1 mb-3"></i>
            <h4 class="mb-3">Call Us</h4>
            <div class="contact-numbers">
              <p class="mb-2">
                <a href="tel:+237675729438" class="text-reset text-decoration-none">
                  (+237) 675 729 438
                </a>
              </p>
              <p class="mb-2">
                <a href="tel:+237675915134" class="text-reset text-decoration-none">
                  (+237) 675 915 134
                </a>
              </p>
              <p class="mb-0">
                <a href="tel:+237697279497" class="text-reset text-decoration-none">
                  (+237) 697 279 497
                </a>
              </p>
            </div>
          </div>
        </div>
        <!-- End Info Item -->

        <div class="col-lg-3 col-md-6">
          <div
            class="info-item card-modern p-4 text-center"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <i class="bi bi-envelope-fill text-warning fs-1 mb-3"></i>
            <h4 class="mb-3">Email Us</h4>
            <p class="mb-0">
              <a href="mailto:rennyblessedconstruction@gmail.com" class="text-reset text-decoration-none">
                rennyblessedconstruction@gmail.com
              </a>
            </p>
          </div>
        </div>
        <!-- End Info Item -->
      </div>

      <div class="row gy-4 mt-1">
        <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.123456789!2d10.1517!3d5.9581!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sNkwen%2C%20Bamenda%2C%20Cameroon!5e0!3m2!1sen!2sus!4v1676961268712!5m2!1sen!2sus"
            frameborder="0"
            style="border: 0; width: 100%; height: 400px; border-radius: 15px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="RB Construction Location - Nkwen, Bamenda, Cameroon"
          ></iframe>
        </div>
        <!-- End Google Maps -->

        <!-- contact form -->
        <%- include("../partials/contact-us/contact-form") %>
        <!-- End Contact Form -->
      </div>
    </div>
  </section>
  <!-- /Contact Section -->
</main>
<%- include("../layout/footer") %>
