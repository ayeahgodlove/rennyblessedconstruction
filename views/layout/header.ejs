      "https://rbconstruction.com/assets/img/hero-carousel/hero-carousel-3.jpg"
    ],
    "description": "Professional construction and engineering services in Cameroon",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Nkwen",
      "addressLocality": "Bamenda",
      "addressRegion": "Northwest Region",
      "addressCountry": "CM"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+237675729438",
      "contactType": "customer service",
      "email": "rennyblessedconstruction@gmail.com",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://m.facebook.com/100083945796508/about/"
    ],
    "foundingDate": "2014",
    "slogan": "Building Dreams, Creating Futures",
    "knowsAbout": [
      "Construction",
      "Engineering",
      "Project Management",
      "Architectural Design",
      "Structural Engineering",
      "Real Estate Development"
    ],
    "areaServed": {
      "@type": "Country",
      "name": "Cameroon"
    },
    "serviceType": [
      "Construction Services",
      "Engineering Services",
      "Project Management",
      "Architectural Design"
    ]
  }
