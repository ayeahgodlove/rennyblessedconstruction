<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <!-- Primary Meta Tags -->
  <title>
    <%= typeof title !=='undefined' ? title : 'RB Construction & Engineering - Professional Construction Services' %>
  </title>
  <meta name="title"
    content="<%= typeof title !== 'undefined' ? title : 'RB Construction & Engineering - Professional Construction Services' %>">
  <meta name="description"
    content="<%= typeof description !== 'undefined' ? description : 'RB Construction & Engineering Associate - Professional construction, engineering, and project management services in Cameroon. Quality craftsmanship and innovative solutions.' %>">
  <meta name="keywords"
    content="<%= typeof keywords !== 'undefined' ? keywords : 'construction, engineering, Cameroon, building, project management, architectural design, structural engineering, real estate development, Bamenda construction, construction company Cameroon' %>">

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : 'https://rbconstruction.com' %>">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= typeof canonical !== 'undefined' ? canonical : 'https://rbconstruction.com' %>">
  <meta property="og:title"
    content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'RB Construction & Engineering - Building Dreams, Creating Futures' %>">
  <meta property="og:description"
    content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Professional construction and engineering services in Cameroon. From architectural design to project completion, we deliver excellence in every project.' %>">
  <meta property="og:image"
    content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://rbconstruction.com/assets/img/hero-carousel/hero-carousel-1.jpg' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="RB Construction & Engineering - Professional Construction Services">
  <meta property="og:site_name" content="RB Construction & Engineering">
  <meta property="og:locale" content="en_US">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url"
    content="<%= typeof canonical !== 'undefined' ? canonical : 'https://rbconstruction.com' %>">
  <meta property="twitter:title"
    content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'RB Construction & Engineering - Building Dreams, Creating Futures' %>">
  <meta property="twitter:description"
    content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Professional construction and engineering services in Cameroon. From architectural design to project completion, we deliver excellence in every project.' %>">
  <meta property="twitter:image"
    content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://rbconstruction.com/assets/img/hero-carousel/hero-carousel-1.jpg' %>">
  <meta property="twitter:image:alt" content="RB Construction & Engineering - Professional Construction Services">
  <meta property="twitter:site" content="@rbconstruction">
  <meta property="twitter:creator" content="@rbconstruction">

  <!-- Additional SEO Meta Tags -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow">
  <meta name="bingbot" content="index, follow">
  <meta name="author" content="RB Construction & Engineering Associate">
  <meta name="publisher" content="RB Construction & Engineering Associate">
  <meta name="copyright" content="RB Construction & Engineering Associate">
  <meta name="language" content="en">
  <meta name="revisit-after" content="7 days">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">
  <meta name="target" content="all">

  <!-- Geographic Meta Tags -->
  <meta name="geo.region" content="CM-NW">
  <meta name="geo.placename" content="Bamenda, Cameroon">
  <meta name="geo.position" content="5.9581;10.1517">
  <meta name="ICBM" content="5.9581, 10.1517">

  <!-- Mobile App Meta Tags -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="RB Construction">

  <!-- Theme Color -->
  <meta name="theme-color" content="#ff6b35">
  <meta name="msapplication-TileColor" content="#ff6b35">
  <meta name="msapplication-navbutton-color" content="#ff6b35">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "RB Construction & Engineering Associate",
    "alternateName": "RB Construction",
