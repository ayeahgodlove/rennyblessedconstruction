<!-- Hero Section -->
<section id="hero" class="hero section dark-background">
  <div class="info d-flex align-items-center">
    <div class="container">
      <div
        class="row justify-content-center"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="col-lg-8 text-center">
          <h2 class="heading-modern mb-4">
            Building Dreams, <span class="text-gradient">Creating Futures</span>
          </h2>
          <p class="lead mb-4">
            RB Construction & Engineering Associate - Your trusted partner for comprehensive construction, 
            engineering, and project management services across Cameroon. We transform visions into reality 
            with precision, innovation, and unwavering commitment to excellence.
          </p>
          <div class="hero-buttons">
            <a href="#get-started" class="btn-get-started me-3">Get Free Quote</a>
            <a href="/projects" class="btn btn-outline-light btn-lg">View Our Work</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="hero-carousel"
    class="carousel slide"
    data-bs-ride="carousel"
    data-bs-interval="5000"
