<!-- Alt Services Section -->
<section id="alt-services" class="alt-services section">
  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2 class="heading-modern">Our <span class="text-gradient">Expert Services</span></h2>
    <p class="lead">
      Comprehensive construction and engineering solutions tailored to meet your unique project requirements. 
      From concept to completion, we deliver excellence in every detail.
    </p>
  </div>
  <!-- End Section Title -->
  <div class="container">
    <div class="row justify-content-around gy-4">
      <div
        class="features-image col-lg-6"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <img src="assets/img/alt-services.jpg" alt="" />
      </div>

      <div
        class="col-lg-5 d-flex flex-column justify-content-center"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <h3 class="heading-modern mb-4">Why Choose <span class="text-gradient">RB Construction?</span></h3>
        <p class="lead mb-4">
          With years of experience and a commitment to quality, we offer comprehensive 
          construction and engineering services that exceed expectations. Our team combines 
          technical expertise with innovative solutions to deliver projects that stand the test of time.
        </p>

        <% services.forEach(service => { %>
        <div
          class="icon-box card-modern p-3 mb-3"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="d-flex align-items-center">
            <div class="service-icon me-3">
              <img
                height="60"
                width="60"
                src="<%= APP_URL %>/assets/uploads/services/<%= service.imageUrl %>"
                alt="<%= service.title %>"
                class="img-fluid"
              />
            </div>
            <div class="service-content">
              <h5 class="mb-2"><a href="/services/<%= stringSlugify(service.title) %>" class="text-decoration-none"><%= service.title %></a></h5>
              <p class="mb-0 text-muted"><%= stringLimiter(service.description, 80) %></p>
            </div>
          </div>
        </div>
        <% }) %>

        <!-- End Icon Box -->
      </div>
    </div>
  </div>
</section>
<!-- /Alt Services Section -->
